# Copy to .env for local overrides (never commit .env).

POSTGRES_USER=citadel
POSTGRES_PASSWORD=citadel
POSTGRES_DB=citadel
DATABASE_URL=postgres://citadel:citadel@localhost:5432/citadel

MINIO_ROOT_USER=citadel
MINIO_ROOT_PASSWORD=citadelminio
MINIO_ENDPOINT=http://localhost:9000

AUTH_SERVICE_PORT=8081
DELIVERY_SERVICE_PORT=8082
DIRECTORY_SERVICE_PORT=8083
BLOBSTORE_SERVICE_PORT=8084

RUST_LOG=info,tower_http=info

# KT log signing seed for the DEV STACK ONLY (ADR-0001 §3): base64 of the
# bytes 0x00..0x1f, fixed so dev tree heads are stable and so the test harness,
# which assumes this exact value when the variable is unset, can verify them.
# It is public and forgeable by design. Production loads its seed from the
# service secret store; compose refuses to start without an explicit value.
CITADEL_KT_LOG_SEED=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
